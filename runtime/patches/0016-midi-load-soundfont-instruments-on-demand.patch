+	/** Keep the default patches available and load custom instruments only as a MIDI player uses them. */
+	public static Receiver getReceiver(Synthesizer synth) throws MidiUnavailableException {
+		Receiver output = synth.getReceiver();
+		if (!useCustomSoundfont()) return output;
+		Soundbank bank = soundbank;
+		MidiChannel[] channels = synth.getChannels();
+		return new Receiver() {
+			private final Set<Integer> checked = new HashSet<>();
+			private boolean customAvailable = true;
+
+			public synchronized void send(MidiMessage message, long timestamp) {
+				int status = message.getStatus();
+				byte[] data = message.getMessage();
+				int channel = status & 15;
+				if (customAvailable && (status & 0xf0) == ShortMessage.NOTE_ON && data.length >= 3 && data[2] != 0
+						&& channel < channels.length && channels[channel] != null) {
+					MidiChannel voice = channels[channel];
+					int patchBank = voice.getController(0) * 128 + voice.getController(32);
+					int program = voice.getProgram();
+					boolean percussion = channel == 9;
+					int key = (patchBank * 128 + program) * 2 + (percussion ? 1 : 0);
+					if (checked.add(key)) {
+						try {
+							Instrument instrument = bank.getInstrument(new ModelPatch(patchBank, program, percussion));
+							if (instrument != null) synth.loadInstrument(instrument);
+						} catch (RuntimeException | OutOfMemoryError e) {
+							customAvailable = false;
+							System.err.println("MGO: custom MIDI instrument unavailable; using the built-in bank for remaining patches.");
+						}
+					}
+				}
+				output.send(message, timestamp);
+			}
+
+			public void close() { output.close(); }
+		};
+	}
+
